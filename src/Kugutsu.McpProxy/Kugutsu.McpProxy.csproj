<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Kugutsu.McpProxy</AssemblyName>
    <RootNamespace>Kugutsu.McpProxy</RootNamespace>
    <OutputPath>../../artifacts/$(Configuration)/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Kugutsu.Contracts/Kugutsu.Contracts.csproj" />
    <Compile Include="../Shared/InstallationPaths.cs" Link="Hosting/InstallationPaths.cs" />
    <Compile Include="../Shared/KugutsuOptions.cs" Link="Hosting/KugutsuOptions.cs" />
    <Compile Include="../Shared/SettingsLoader.cs" Link="Hosting/SettingsLoader.cs" />
    <Compile Include="../Shared/SettingsValidator.cs" Link="Hosting/SettingsValidator.cs" />
    <Compile Include="../Shared/StructuredLog.cs" Link="Hosting/StructuredLog.cs" />
    <Compile Include="../Shared/LogRetention.cs" Link="Hosting/LogRetention.cs" />
    <Compile Include="../Shared/CredentialLoader.cs" Link="Hosting/CredentialLoader.cs" />
    <Compile Include="../Shared/BearerCredential.cs" Link="Hosting/BearerCredential.cs" />
    <Compile Include="../Shared/SessionProtocol.cs" Link="Hosting/SessionProtocol.cs" />
  </ItemGroup>
  <Target Name="CopyDefaultSettings" AfterTargets="Build">
    <Copy SourceFiles="../../config/appsettings.json" DestinationFiles="$(OutputPath)../config/appsettings.json" SkipUnchangedFiles="true" Condition="!Exists('$(OutputPath)../config/appsettings.json')" />
  </Target>
</Project>
